# ============================================================================
# cachicamas — top-level .gitignore
# Service-level ignores live in their own .gitignore files
# (e.g. backend/database_administrator/.gitignore).
# ============================================================================

# ----- Secrets & runtime state -------------------------------------------
.env
.env.*
!.env.example
data/
*.log

# ----- Docker / Compose artifacts ---------------------------------------
# Don't ignore docker-compose.yaml or Dockerfile — those are source.
docker-compose.override.yaml
docker-compose.override.yml
*.dockerfile.local

# ----- Editor / OS noise ------------------------------------------------
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# ----- Build outputs (if someone runs `go build ./...` at the root) -----
**/bin/
**/dist/
node_modules/

# ----- Test coverage ----------------------------------------------------
coverage.out
coverage.html
coverage.txt

# ----- Agent tooling metadata -------------------------------------------
# Atlassian / local agent registries — generated per-host, never tracked.
.atl/
# Pi runtime cache — generated by the Pi subagent/orchestrator on the host.
.pi/
.pi-subagents/
# CodeGraph index — per-checkout SQLite graph, ~20 MB, rebuilt on demand.
# Each worktree needs its own, so it must never be shared through git.
.codegraph/
# Claude / OpenCode evidence files — generated per-host by the agent
# orchestrator during sdd-apply (focused test output, settle corrections,
# RED-GREEN evidence). Useful locally for debugging; never tracked.
.claude/evidence/

# ----- Go workspace ------------------------------------------------------
# go.work is tracked. Its checksum file, go.work.sum, was NOT tracked before
# AI-37: no module in the workspace carried a dependency, so it was always
# generated empty and ignoring it kept `git status` honest. AI-37 (ADR 0005
# § D3) is the first change to give backend/agent a real dependency, which
# makes go.work.sum carry real verification hashes for the first time
# (agent-module-scaffold R-AGM-003, S-AGM-068) — it is now tracked and MUST
# be committed alongside any change to a workspace module's own go.sum.__pycache__/
