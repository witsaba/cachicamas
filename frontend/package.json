{
  "name": "@cachicamas/frontend",
  "description": "Cachicamas frontend — marketing-only Qwik app",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0",
    "pnpm": ">=11.8.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "packageManager": "pnpm@11.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "verify": "pnpm lint && pnpm build.types && pnpm fmt.check && pnpm test:ci",
    "build": "pnpm build.types && pnpm build.client && pnpm build.server",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/node-server/vite.config.ts",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.types": "tsc --incremental --noEmit --pretty false",
    "deploy": "echo 'Run \"npm run qwik add\" to install a server adapter'",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint --format json \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "test.unit": "vitest",
    "test:ci": "vitest --run --reporter=json",
    "test.unit.ui": "vitest --ui",
    "vuln-check": "pnpm audit --json --audit-level=moderate",
    "vuln-check:prod": "pnpm audit --prod --audit-level=moderate",
    "vuln-check:ci": "pnpm run vuln-check",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.0",
    "@builder.io/qwik-city": "^1.20.0",
    "@eslint/js": "^9",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "20.19.0",
    "@vitest/ui": "^4.1.10",
    "eslint": "9.32.0",
    "eslint-plugin-qwik": "^1.20.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.4",
    "typescript": "5.4.5",
    "typescript-eslint": "8.38.0",
    "typescript-plugin-css-modules": "latest",
    "undici": "^8.9.0",
    "vite": "^7.3.5",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "isomorphic-dompurify": "^2.26.0",
    "marked": "^18.0.6",
    "zod": "3.25.48"
  }
}
