# ============================================================================
# Cachicamas — environment variables template
# Copy this file to `.env` next to docker-compose.yaml and edit as needed.
# NEVER commit `.env` to git.
# ============================================================================

# ----- Project -----
PROJECT_NAME=cachicamas
COMPOSE_PROJECT_NAME=${PROJECT_NAME}

# ----- PostgreSQL -----
# POSTGRES_USER is the SUPERUSER the official image creates during
# initdb. Required for cluster bootstrap. The application does NOT use
# this account — it connects as `queen` (see below).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cachicamas_pg
POSTGRES_USER=cachicamas
POSTGRES_PASSWORD=changeme-local-only
# PGDATA relocated to the path expected by postgres:18-alpine's pg_ctlcluster
# layout. Don't change unless you know what you're doing.
POSTGRES_INITDB_ARGS="--encoding=UTF8 --locale=C"

# ----- DBA role (`queen`) -----
# The only non-superuser provisioned by the docker-compose init flow.
# Has CREATEROLE + CREATEDB + REPLICATION; can create other roles
# (e.g. `cachicamas_app`, `wiki`) and databases. Until a least-privilege
# app role is created, the microservices also connect as queen.
QUEEN_USER=queen
QUEEN_PASSWORD=changeme-queen

# ----- database_administrator service -----
SERVICE_NAME=database_administrator
SERVICE_PORT=8080
SERVICE_ENV=development

# ----- OpenTelemetry -----
# Endpoint the application uses to push traces/metrics/logs to the collector.
# Inside the docker network the collector is reachable as `otel-collector`.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=${SERVICE_NAME}
OTEL_RESOURCE_ATTRIBUTES=service.namespace=${PROJECT_NAME},deployment.environment=${SERVICE_ENV}

# ----- Jaeger -----
# UI is exposed on host; collector exports OTLP to the same image's OTLP
# receiver (jaeger v2 is built on the OTel collector).
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318

# ----- OTel Collector -----
# Collector host-ports are offset (14xxx) to avoid colliding with
# Jaeger's own :4317/:4318 publishes (Docker Desktop can hold a stale
# :4317 bind across container restarts via the vpnkit sidecar).
# The collector still listens on :4317 inside the container; only the
# host-side mapping is shifted.
OTEL_COLLECTOR_GRPC_PORT=14317
OTEL_COLLECTOR_HTTP_PORT=14318
OTEL_COLLECTOR_HEALTH_PORT=13133